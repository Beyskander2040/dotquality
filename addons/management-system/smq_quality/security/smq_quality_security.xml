<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_smq" model="ir.module.category">
        <field name="name">SMQ</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_smq_employee" model="res.groups">
        <field name="name">Employé</field>
        <field name="category_id" ref="module_category_smq" />
    </record>

    <record id="group_smq_writer" model="res.groups">
        <field name="name">Rédacteur</field>
        <field name="category_id" ref="module_category_smq" />
        <field name="implied_ids" eval="[(4, ref('group_smq_employee'))]" />
    </record>

    <record id="group_smq_verifier" model="res.groups">
        <field name="name">Vérificateur</field>
        <field name="category_id" ref="module_category_smq" />
        <field name="implied_ids" eval="[(4, ref('group_smq_writer'))]" />
    </record>

    <record id="group_smq_quality_manager" model="res.groups">
        <field name="name">Responsable Qualité</field>
        <field name="category_id" ref="module_category_smq" />
        <field name="implied_ids" eval="[(4, ref('group_smq_verifier'))]" />
    </record>

    <record id="group_smq_direction" model="res.groups">
        <field name="name">Direction</field>
        <field name="category_id" ref="module_category_smq" />
        <field name="implied_ids" eval="[(4, ref('group_smq_quality_manager'))]" />
    </record>

    <record id="group_smq_admin" model="res.groups">
        <field name="name">Administrateur SMQ</field>
        <field name="category_id" ref="module_category_smq" />
        <field name="implied_ids" eval="[(4, ref('group_smq_direction'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="smq_process_company_rule" model="ir.rule">
        <field name="name">smq.process multi-company</field>
        <field name="model_id" ref="model_smq_process" />
        <field name="global" eval="True" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
