<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_process_version_reject_wizard_form" model="ir.ui.view">
        <field name="name">smq.process.version.reject.wizard.form</field>
        <field name="model">smq.process.version.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Motif du rejet">
                <field name="version_id" invisible="1" />
                <group>
                    <field name="reason" nolabel="1" placeholder="Expliquez pourquoi cette version est rejetée..." />
                </group>
                <footer>
                    <button name="action_confirm" string="Rejeter" type="object" class="btn-primary" />
                    <button string="Annuler" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
