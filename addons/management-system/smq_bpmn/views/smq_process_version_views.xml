<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_process_version_tree" model="ir.ui.view">
        <field name="name">smq.process.version.tree</field>
        <field name="model">smq.process.version</field>
        <field name="arch" type="xml">
            <tree>
                <field name="process_id" />
                <field name="version" />
                <field name="name" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state in ('draft', 'rejected')"
                    decoration-info="state == 'review'"
                    decoration-success="state in ('approved', 'effective')"
                    decoration-warning="state == 'obsolete'"
                    decoration-danger="state == 'rejected'"
                />
                <field name="created_by" />
                <field name="created_date" />
                <field name="approved_by" />
                <field name="approved_date" />
                <field name="effective_by" />
                <field name="effective_date" />
            </tree>
        </field>
    </record>

    <record id="view_smq_process_version_form" model="ir.ui.view">
        <field name="name">smq.process.version.form</field>
        <field name="model">smq.process.version</field>
        <field name="arch" type="xml">
            <form string="Version de processus (BPMN)">
                <header>
                    <button
                        name="action_submit_review"
                        string="Soumettre en révision"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="smq_quality.group_smq_writer"
                    />
                    <button
                        name="action_approve"
                        string="Approuver"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'review'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_reject"
                        string="Rejeter"
                        type="object"
                        invisible="state != 'review'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_reset_to_draft"
                        string="Corriger (retour brouillon)"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'rejected'"
                        groups="smq_quality.group_smq_writer"
                    />
                    <button
                        name="action_make_effective"
                        string="Mettre en vigueur"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'approved'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_obsolete"
                        string="Obsolète"
                        type="object"
                        invisible="state != 'effective'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_create_new_version"
                        string="Créer une nouvelle version"
                        type="object"
                        groups="smq_quality.group_smq_writer"
                    />
                    <button
                        name="action_check_mappings"
                        string="Vérifier les mappings"
                        type="object"
                    />
                    <button
                        name="action_save_as_template"
                        string="Enregistrer comme modèle"
                        type="object"
                        invisible="not step_ids"
                        groups="smq_quality.group_smq_admin"
                    />
                    <button
                        name="action_start_instance_button"
                        string="Démarrer une instance"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'effective'"
                        groups="smq_quality.group_smq_writer"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,review,approved,effective,obsolete"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_instances"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-play-circle"
                            invisible="instance_count == 0"
                        >
                            <field name="instance_count" widget="statinfo" string="Instances" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Rejetée"
                        bg_color="bg-danger"
                        invisible="state != 'rejected'"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="process_id" placeholder="Processus" />
                        </h1>
                        <h2>
                            <field name="version" placeholder="ex. 1.0" />
                        </h2>
                    </div>
                    <group>
                        <group string="Version">
                            <field name="name" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Traçabilité">
                            <field name="created_by" />
                            <field name="created_date" />
                            <field name="approved_by" />
                            <field name="approved_date" />
                            <field name="effective_by" />
                            <field name="effective_date" />
                            <field name="obsolete_date" />
                        </group>
                    </group>
                    <group string="Rejet" invisible="not rejection_reason">
                        <field name="rejected_by" />
                        <field name="rejected_date" />
                        <field name="rejection_reason" nolabel="1" colspan="2" />
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" />
                    </group>
                    <group string="Description structurée du processus">
                        <button
                            name="action_validate_process_description"
                            string="Valider la description"
                            type="object"
                            invisible="state != 'draft'"
                        />
                        <button
                            name="action_generate_bpmn_from_description"
                            string="Générer le BPMN"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="smq_quality.group_smq_writer"
                        />
                        <field name="step_ids" nolabel="1" colspan="2" readonly="state != 'draft'">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="code" />
                                <field name="name" />
                                <field name="step_type" />
                                <field name="responsible_user_id" />
                                <field name="description" optional="hide" />
                                <field
                                    name="procedure_document_id"
                                    readonly="1"
                                    force_save="0"
                                    help="Configuré depuis le panneau de propriétés du diagramme BPMN, pas depuis ce tableau."
                                />
                                <field
                                    name="form_document_id"
                                    readonly="1"
                                    force_save="0"
                                    help="Configuré depuis le panneau de propriétés du diagramme BPMN, pas depuis ce tableau."
                                />
                            </tree>
                        </field>
                        <field name="transition_ids" nolabel="1" colspan="2" readonly="state != 'draft'">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field
                                    name="source_step_id"
                                    domain="[('process_version_id', '=', parent.id)]"
                                />
                                <field
                                    name="target_step_id"
                                    domain="[('process_version_id', '=', parent.id)]"
                                />
                                <field name="condition" />
                            </tree>
                        </field>
                    </group>
                    <group string="BPMN">
                        <field name="bpmn_checksum" readonly="1" />
                        <field
                            name="bpmn_xml"
                            widget="smq_bpmn_editor"
                            nolabel="1"
                            colspan="2"
                            readonly="state != 'draft'"
                        />
                    </group>
                    <group string="Mappings BPMN → Odoo">
                        <field name="mapping_ids" nolabel="1">
                            <tree>
                                <field name="bpmn_element_id" />
                                <field name="element_name" />
                                <field name="element_type" />
                                <field name="task_type" />
                                <field name="odoo_model_id" />
                                <field name="odoo_method" />
                                <field
                                    name="is_orphaned"
                                    widget="badge"
                                    decoration-danger="is_orphaned"
                                    decoration-success="not is_orphaned"
                                />
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_smq_process_version_search" model="ir.ui.view">
        <field name="name">smq.process.version.search</field>
        <field name="model">smq.process.version</field>
        <field name="arch" type="xml">
            <search string="Versions de processus (BPMN)">
                <field name="process_id" />
                <field name="version" />
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]" />
                <filter name="filter_review" string="En révision" domain="[('state', '=', 'review')]" />
                <filter name="filter_approved" string="Approuvée" domain="[('state', '=', 'approved')]" />
                <filter name="filter_effective" string="En vigueur" domain="[('state', '=', 'effective')]" />
                <filter name="filter_rejected" string="Rejetée" domain="[('state', '=', 'rejected')]" />
                <filter name="filter_obsolete" string="Obsolète" domain="[('state', '=', 'obsolete')]" />
                <group expand="0" string="Grouper par">
                    <filter name="group_by_process" string="Processus" context="{'group_by': 'process_id'}" />
                    <filter name="group_by_state" string="État" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_smq_process_version" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">smq.process.version</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_smq_process_version_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez la première version BPMN d'un processus.
            </p>
        </field>
    </record>

</odoo>
