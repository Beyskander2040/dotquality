<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Bandes pour un score global de 0 à 5 (moyenne pondérée des
         critères, eux-mêmes notés de 0 à 5). Seuils et libellés restent
         modifiables par l'administrateur (menu Configuration). -->

    <record id="smq_supplier_qualification_not_approved" model="smq.supplier.qualification.level">
        <field name="name">Non agréé</field>
        <field name="min_score">0</field>
        <field name="max_score">1</field>
        <field name="color">1</field>
        <field name="sequence">10</field>
    </record>

    <record id="smq_supplier_qualification_watch" model="smq.supplier.qualification.level">
        <field name="name">Sous surveillance</field>
        <field name="min_score">2</field>
        <field name="max_score">3</field>
        <field name="color">3</field>
        <field name="sequence">20</field>
    </record>

    <record id="smq_supplier_qualification_approved" model="smq.supplier.qualification.level">
        <field name="name">Agréé</field>
        <field name="min_score">4</field>
        <field name="max_score">5</field>
        <field name="color">10</field>
        <field name="sequence">30</field>
    </record>

</odoo>
