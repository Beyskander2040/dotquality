<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_wiki_form_document_upload" model="ir.ui.view">
        <field name="name">document.page.form.smq.document.upload</field>
        <field name="model">document.page</field>
        <field name="inherit_id" ref="document_page.view_wiki_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='content']" position="before">
                <label for="document_ids" string="Fichiers joints" />
                <field
                    name="document_ids"
                    widget="many2many_binary"
                    nolabel="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
