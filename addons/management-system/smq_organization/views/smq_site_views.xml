<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_site_tree" model="ir.ui.view">
        <field name="name">smq.site.tree</field>
        <field name="model">smq.site</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="address_id" />
            </tree>
        </field>
    </record>

    <record id="view_smq_site_form" model="ir.ui.view">
        <field name="name">smq.site.form</field>
        <field name="model">smq.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom" />
                        <h1>
                            <field name="name" placeholder="ex. Siège Tunis" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="address_id" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="active" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smq_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">smq.site</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier site.
            </p>
        </field>
    </record>

</odoo>
