<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_document_type_tree" model="ir.ui.view">
        <field name="name">smq.document.type.tree</field>
        <field name="model">smq.document.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="code_prefix" />
                <field name="name" />
                <field name="requires_process" />
                <field name="review_period" />
            </tree>
        </field>
    </record>

    <record id="view_smq_document_type_form" model="ir.ui.view">
        <field name="name">smq.document.type.form</field>
        <field name="model">smq.document.type</field>
        <field name="arch" type="xml">
            <form string="Type de document">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code_prefix" />
                        <field name="requires_process" />
                        <field name="review_period" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smq_document_type" model="ir.actions.act_window">
        <field name="name">Types de documents</field>
        <field name="res_model">smq.document.type</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
