<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_document_version_reject_wizard_form" model="ir.ui.view">
        <field name="name">smq.document.version.reject.wizard.form</field>
        <field name="model">smq.document.version.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Motif du rejet">
                <field name="version_id" invisible="1" />
                <group>
                    <field name="reason" nolabel="1" placeholder="Expliquez pourquoi cette version est rejetée..." />
                </group>
                <footer>
                    <button name="action_confirm" string="Rejeter" type="object" class="btn-primary" />
                    <button string="Annuler" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_smq_document_version_effective_wizard_form" model="ir.ui.view">
        <field name="name">smq.document.version.effective.wizard.form</field>
        <field name="model">smq.document.version.effective.wizard</field>
        <field name="arch" type="xml">
            <form string="Date d'entrée en vigueur">
                <field name="version_id" invisible="1" />
                <group>
                    <field name="effective_date" />
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmer" type="object" class="btn-primary" />
                    <button string="Annuler" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_smq_document_periodic_review_wizard_form" model="ir.ui.view">
        <field name="name">smq.document.periodic.review.wizard.form</field>
        <field name="model">smq.document.periodic.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Revue périodique">
                <field name="document_id" invisible="1" />
                <group>
                    <field name="review_date" />
                </group>
                <field
                    name="comment"
                    placeholder="Observation éventuelle (ex. aucun changement nécessaire, point vérifié)..."
                />
                <footer>
                    <button name="action_confirm" string="Confirmer la revue" type="object" class="btn-primary" />
                    <button string="Annuler" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
