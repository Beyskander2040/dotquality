<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_activity_tree" model="ir.ui.view">
        <field name="name">smq.activity.tree</field>
        <field name="model">smq.activity</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="view_smq_activity_form" model="ir.ui.view">
        <field name="name">smq.activity.form</field>
        <field name="model">smq.activity</field>
        <field name="arch" type="xml">
            <form string="Activité">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="active" />
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smq_activity" model="ir.actions.act_window">
        <field name="name">Activités</field>
        <field name="res_model">smq.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première activité.
            </p>
        </field>
    </record>

</odoo>
