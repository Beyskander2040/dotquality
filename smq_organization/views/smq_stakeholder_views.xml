<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_stakeholder_tree" model="ir.ui.view">
        <field name="name">smq.stakeholder.tree</field>
        <field name="model">smq.stakeholder</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="category" />
                <field name="influence_level" />
                <field name="partner_id" />
            </tree>
        </field>
    </record>

    <record id="view_smq_stakeholder_form" model="ir.ui.view">
        <field name="name">smq.stakeholder.form</field>
        <field name="model">smq.stakeholder</field>
        <field name="arch" type="xml">
            <form string="Partie intéressée">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom" />
                        <h1>
                            <field name="name" placeholder="ex. Autorités de régulation bancaire" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="influence_level" />
                            <field name="active" />
                        </group>
                    </group>
                    <group string="Attentes / exigences">
                        <field name="expectations" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_smq_stakeholder_search" model="ir.ui.view">
        <field name="name">smq.stakeholder.search</field>
        <field name="model">smq.stakeholder</field>
        <field name="arch" type="xml">
            <search string="Parties intéressées">
                <field name="name" />
                <filter name="group_by_category" string="Catégorie" context="{'group_by': 'category'}" />
            </search>
        </field>
    </record>

    <record id="action_smq_stakeholder" model="ir.actions.act_window">
        <field name="name">Parties intéressées</field>
        <field name="res_model">smq.stakeholder</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_smq_stakeholder_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Identifiez votre première partie intéressée.
            </p>
        </field>
    </record>

</odoo>
