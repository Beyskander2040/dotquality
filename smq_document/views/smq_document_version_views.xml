<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_document_version_tree" model="ir.ui.view">
        <field name="name">smq.document.version.tree</field>
        <field name="model">smq.document.version</field>
        <field name="arch" type="xml">
            <tree>
                <field name="display_version" string="Version" />
                <field name="state" />
                <field name="author_id" />
                <field name="change_reason" />
                <field name="effective_date" />
                <field name="obsolete_date" />
            </tree>
        </field>
    </record>

    <record id="view_smq_document_version_form" model="ir.ui.view">
        <field name="name">smq.document.version.form</field>
        <field name="model">smq.document.version</field>
        <field name="arch" type="xml">
            <form string="Version de document">
                <header>
                    <button
                        name="action_submit_validation"
                        string="Soumettre en validation"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="smq_quality.group_smq_writer"
                    />
                    <button
                        name="action_validate"
                        string="Valider"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'in_validation'"
                        groups="smq_quality.group_smq_verifier"
                    />
                    <button
                        name="action_reject"
                        string="Rejeter"
                        type="object"
                        invisible="state != 'in_validation'"
                        groups="smq_quality.group_smq_verifier"
                    />
                    <button
                        name="action_publish"
                        string="Publier"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'approved'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_set_effective"
                        string="Rendre effectif"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'published'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_set_obsolete"
                        string="Rendre obsolète"
                        type="object"
                        invisible="state in ('obsolete', 'draft')"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,in_validation,approved,published,effective"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_version" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="document_id" readonly="1" />
                            <field name="previous_version_id" readonly="1" />
                            <field name="author_id" readonly="state != 'draft'" />
                        </group>
                        <group string="Traçabilité">
                            <field name="submitted_by" readonly="1" invisible="not submitted_by" />
                            <field name="submission_date" readonly="1" invisible="not submission_date" />
                            <field name="validated_by" readonly="1" invisible="not validated_by" />
                            <field name="approval_date" readonly="1" invisible="not approval_date" />
                            <field name="published_by" readonly="1" invisible="not published_by" />
                            <field name="publication_date" readonly="1" invisible="not publication_date" />
                            <field name="set_effective_by" readonly="1" invisible="not set_effective_by" />
                            <field name="effective_date" readonly="1" invisible="not effective_date" />
                            <field name="obsolete_date" readonly="1" invisible="not obsolete_date" />
                        </group>
                    </group>
                    <group string="Dernier rejet" invisible="not rejected_by">
                        <field name="rejected_by" readonly="1" />
                        <field name="rejection_date" readonly="1" />
                        <field name="rejection_reason" readonly="1" nolabel="1" />
                    </group>
                    <group string="Motif et description des changements">
                        <field name="change_reason" readonly="state != 'draft'" />
                        <field name="change_description" nolabel="1" placeholder="Description détaillée des changements..." readonly="state != 'draft'" />
                    </group>
                    <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'" />
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

</odoo>
