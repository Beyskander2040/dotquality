<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Chaque smq.document crée automatiquement sa V1 (brouillon) à la
         création — voir smq.document.create(). Les fonctions ci-dessous
         configurent cette V1 pour la démonstration au lieu d'en créer une
         seconde en doublon. -->

    <!-- POL-001 — Politique Qualité — en vigueur -->
    <record id="smq_document_pol_001" model="smq.document">
        <field name="name">Politique Qualité</field>
        <field name="document_type_id" ref="smq_document_type_pol" />
        <field name="process_id" ref="smq_quality.smq_process_pr01" />
        <field name="responsible_id" ref="base.user_admin" />
        <field name="department">Direction</field>
    </record>
    <function model="smq.document" name="_demo_configure_first_version">
        <value eval="[ref('smq_document_pol_001')]" />
        <value
            eval="{
                'author_id': ref('base.user_admin'),
                'state': 'effective',
                'submitted_by': ref('base.user_admin'),
                'submission_date': '2026-02-05 09:00:00',
                'validated_by': ref('base.user_admin'),
                'approval_date': '2026-02-10 09:00:00',
                'published_by': ref('base.user_admin'),
                'publication_date': '2026-02-12 09:00:00',
                'set_effective_by': ref('base.user_admin'),
                'effective_date': '2026-03-01 09:00:00',
            }"
        />
    </function>

