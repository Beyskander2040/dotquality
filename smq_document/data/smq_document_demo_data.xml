                'author_id': ref('base.user_admin'),
                'state': 'obsolete',
                'validated_by': ref('base.user_admin'),
                'approval_date': '2025-03-05 09:00:00',
                'published_by': ref('base.user_admin'),
                'publication_date': '2025-03-07 09:00:00',
                'set_effective_by': ref('base.user_admin'),
                'effective_date': '2025-03-15 09:00:00',
                'obsolete_date': '2026-03-01 09:00:00',
            }"
        />
    </function>
    <function model="smq.document" name="_demo_add_next_version">
        <value eval="[ref('smq_document_proc_001')]" />
        <value
            eval="{
                'author_id': ref('base.user_admin'),
                'change_reason': 'process_improvement',
                'change_description': 'Ajout du circuit de validation des révisions.',
