<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_process_kanban" model="ir.ui.view">
        <field name="name">smq.process.kanban</field>
        <field name="model">smq.process</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" quick_create="false">
                <field name="code" />
                <field name="name" />
                <field name="status" />
                <field name="responsible_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><t t-esc="record.code.value" /> — <t t-esc="record.name.value" /></span>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="responsible_id" widget="many2one_avatar_user" />
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="status" widget="label_selection" options="{'classes': {'draft': 'default', 'active': 'success', 'archived': 'danger'}}" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_smq_process_tree" model="ir.ui.view">
        <field name="name">smq.process.tree</field>
        <field name="model">smq.process</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="category_id" />
                <field name="responsible_id" />
                <field name="status" decoration-success="status == 'active'" decoration-muted="status == 'archived'" />
            </tree>
        </field>
    </record>

    <record id="view_smq_process_form" model="ir.ui.view">
        <field name="name">smq.process.form</field>
        <field name="model">smq.process</field>
        <field name="arch" type="xml">
            <form string="Processus SMQ">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': 1}" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" invisible="active" />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <label for="code" string="Code" />
                        <h2>
                            <field name="code" placeholder="ex. PR-01" />
                        </h2>
                        <label for="name" string="Nom" />
                        <h1>
                            <field name="name" placeholder="ex. Gestion des achats" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" />
                            <field name="responsible_id" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Objet et périmètre du processus..." />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_smq_process_search" model="ir.ui.view">
        <field name="name">smq.process.search</field>
        <field name="model">smq.process</field>
        <field name="arch" type="xml">
            <search string="Processus SMQ">
                <field name="code" />
                <field name="name" />
                <field name="category_id" />
                <field name="responsible_id" />
                <filter name="filter_active" string="Actifs" domain="[('status', '=', 'active')]" />
                <filter name="filter_draft" string="Brouillons" domain="[('status', '=', 'draft')]" />
                <filter name="filter_archived" string="Archivés" domain="[('status', '=', 'archived')]" />
                <group expand="0" string="Grouper par">
                    <filter name="group_by_category" string="Catégorie" context="{'group_by': 'category_id'}" />
                    <filter name="group_by_responsible" string="Responsable" context="{'group_by': 'responsible_id'}" />
                    <filter name="group_by_status" string="Statut" context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_smq_process" model="ir.actions.act_window">
        <field name="name">Processus</field>
        <field name="res_model">smq.process</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_smq_process_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier processus qualité.
            </p>
        </field>
    </record>

    <!-- Configuration : catégories de processus -->

    <record id="view_smq_process_category_tree" model="ir.ui.view">
        <field name="name">smq.process.category.tree</field>
        <field name="model">smq.process.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="action_smq_process_category" model="ir.actions.act_window">
        <field name="name">Catégories de processus</field>
        <field name="res_model">smq.process.category</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
