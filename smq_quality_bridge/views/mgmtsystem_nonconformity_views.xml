<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_smq_nonconformity_tree" model="ir.ui.view">
        <field name="name">smq.nonconformity.tree</field>
        <field name="model">mgmtsystem.nonconformity</field>
        <field name="arch" type="xml">
            <tree decoration-danger="priority == '3'">
                <field name="ref" />
                <field name="name" />
                <field name="quality_process_id" />
                <field name="nc_type" />
                <field name="department_id" optional="hide" />
                <field name="origin_ids" widget="many2many_tags" optional="hide" />
                <field name="severity_id" />
                <field name="priority" widget="priority" />
                <field name="responsible_user_id" />
                <field name="stage_id" />
                <field name="date" />
                <field name="next_action_deadline" />
                <field name="action_count" string="Actions" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="view_smq_nonconformity_kanban" model="ir.ui.view">
        <field name="name">smq.nonconformity.kanban</field>
        <field name="model">mgmtsystem.nonconformity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="ref" />
                <field name="name" />
                <field name="quality_process_id" />
                <field name="severity_id" />
                <field name="responsible_user_id" />
                <field name="next_action_deadline" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><t t-esc="record.ref.value" /> — <t t-esc="record.name.value" /></span>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="quality_process_id" />
                                <br />
                                <span t-if="record.severity_id.value" class="badge text-bg-danger">
                                    <t t-esc="record.severity_id.value" />
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <t t-esc="record.next_action_deadline.value or ''" />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_user_id" widget="many2one_avatar_user" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_smq_nonconformity_form" model="ir.ui.view">
        <field name="name">smq.nonconformity.form</field>
        <field name="model">mgmtsystem.nonconformity</field>
        <field name="arch" type="xml">
            <form string="Non-conformité">
                <header>
                    <button
                        name="action_start_analysis"
                        string="Commencer l'analyse"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="smq_quality.group_smq_verifier"
                    />
                    <button
                        name="action_start_treatment"
                        string="Passer en traitement"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'analysis'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_mark_resolved"
                        string="Marquer comme résolue"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'open'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <button
                        name="action_close"
                        string="Clôturer"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'resolved'"
                        groups="smq_quality.group_smq_quality_manager"
                    />
                    <field name="stage_id" widget="statusbar" />
                </header>
                <sheet>
                    <field name="state" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_actions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-check-square-o"
                            invisible="action_count == 0"
                        >
                            <field name="action_count" widget="statinfo" string="Actions correctives" />
                        </button>
                        <button
                            name="action_view_smq_documents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="smq_document_count == 0"
                        >
                            <field name="smq_document_count" widget="statinfo" string="Documents" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="ref" string="Référence" />
                        <h2>
                            <field name="ref" />
                        </h2>
                        <label for="name" string="Titre" />
                        <h1>
                            <field name="name" placeholder="ex. Délai de traitement des réclamations dépassé" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="quality_process_id" />
                            <field name="department_id" />
                            <field name="responsible_user_id" />
                            <field name="date" />
                        </group>
                        <group>
                            <field name="manager_user_id" />
                            <field name="user_id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page name="origin" string="Origine &amp; Évaluation">
                            <group>
                                <group string="Source">
                                    <field name="nc_type" />
                                    <field name="origin_ids" widget="many2many_tags" />
                                </group>
                                <group string="Évaluation">
                                    <field name="severity_id" />
                                    <field name="priority" widget="priority" />
                                    <field name="impact" />
                                </group>
                            </group>
                        </page>
                        <page name="description" string="Description">
                            <group>
                                <field name="description" placeholder="Description de la non-conformité..." />
                                <field name="observation" placeholder="Constat effectué..." />
                                <field name="requirement_concerned" />
                            </group>
                            <separator string="Preuves / Pièces jointes" />
                            <field name="attachment_ids" widget="many2many_binary" nolabel="1" />
                        </page>
                        <page
                            name="causes_analysis"
                            string="Analyse"
                            invisible="state in ('draft', 'cancel')"
                        >
                            <group>
                                <group string="Cause">
                                    <field name="immediate_cause" />
                                    <field name="root_cause" />
                                    <field name="analysis_method" />
                                </group>
                                <group string="Commentaire">
                                    <field name="analysis" nolabel="1" />
                                </group>
                            </group>
                            <separator string="Causes (référentiel qualité)" />
                            <field name="cause_ids" options="{'no_create': True}">
                                <tree editable="bottom">
                                    <field name="parent_id" />
                                    <field name="name" />
                                </tree>
                            </field>
                        </page>
                        <page
                            name="actions"
                            string="Plan d'action &amp; Clôture"
                            invisible="state in ('draft', 'analysis', 'cancel')"
                        >
                            <group string="Plan d'action">
                                <field name="action_comments" nolabel="1" placeholder="Plan d'action..." />
                            </group>
                            <separator string="Actions correctives" />
                            <field name="action_ids" context="{'default_type_action': 'correction'}">
                                <tree editable="bottom">
                                    <field name="reference" />
                                    <field name="name" />
                                    <field name="user_id" />
                                    <field name="date_deadline" />
                                    <field name="stage_id" />
                                    <field name="efficacy_result" />
                                </tree>
                            </field>
                            <p class="text-muted">
                                La vérification de l'efficacité (vérificateur, date, résultat) se renseigne
                                sur chaque action corrective, dans son onglet "Efficacité".
                            </p>
                            <group
                                string="Vérification de l'efficacité"
                                invisible="state not in ('resolved', 'done')"
                            >
                                <field name="evaluation_comments" nolabel="1" placeholder="Conclusion de la vérification d'efficacité..." />
                            </group>
                            <group string="Clôture" invisible="state != 'done'">
                                <field name="closing_date" readonly="1" />
                                <field name="closed_by_id" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_smq_nonconformity_search" model="ir.ui.view">
        <field name="name">smq.nonconformity.search</field>
        <field name="model">mgmtsystem.nonconformity</field>
        <field name="arch" type="xml">
            <search string="Non-conformités">
                <field name="ref" />
                <field name="name" />
                <field name="quality_process_id" />
                <field name="department_id" />
                <field name="responsible_user_id" />
                <field name="origin_ids" />
                <field name="nc_type" />
                <filter name="filter_mine" string="Mes NC" domain="['|', ('responsible_user_id', '=', uid), ('user_id', '=', uid)]" />
                <separator />
                <filter name="filter_draft" string="Ouvertes" domain="[('state', '=', 'draft')]" />
                <filter name="filter_analysis" string="En analyse" domain="[('state', '=', 'analysis')]" />
                <filter name="filter_open" string="En traitement" domain="[('state', '=', 'open')]" />
                <filter name="filter_resolved" string="Résolues" domain="[('state', '=', 'resolved')]" />
                <filter name="filter_done" string="Clôturées" domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="filter_critical" string="Critiques" domain="[('priority', '=', '3')]" />
                <filter name="filter_major" string="Majeures" domain="[('severity_id.name', 'ilike', 'Majeure')]" />
                <group expand="0" string="Grouper par">
                    <filter name="group_by_process" string="Processus" context="{'group_by': 'quality_process_id'}" />
                    <filter name="group_by_department" string="Département" context="{'group_by': 'department_id'}" />
                    <filter name="group_by_type" string="Type" context="{'group_by': 'nc_type'}" />
                    <filter name="group_by_stage" string="Statut" context="{'group_by': 'stage_id'}" />
                    <filter name="group_by_severity" string="Gravité" context="{'group_by': 'severity_id'}" />
                    <filter name="group_by_responsible" string="Responsable" context="{'group_by': 'responsible_user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_smq_nonconformity" model="ir.actions.act_window">
        <field name="name">Non-conformités</field>
        <field name="res_model">mgmtsystem.nonconformity</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_smq_nonconformity_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Déclarez votre première non-conformité.</p>
        </field>
    </record>

    <!-- Fixe explicitement la vue utilisée par chaque mode d'affichage :
         mgmtsystem.nonconformity porte à la fois les vues OCA (natives) et
         les vues SMQ définies ci-dessus. Sans cette précision, le choix de
         la vue par défaut dépend d'un ordre implicite et n'est pas garanti
         (cf. LOT 2 sur mgmtsystem.review) — on l'épingle donc explicitement
         pour les trois modes, plutôt que de laisser Odoo deviner. -->
    <record id="action_smq_nonconformity_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_smq_nonconformity_kanban" />
        <field name="act_window_id" ref="action_smq_nonconformity" />
    </record>

    <record id="action_smq_nonconformity_view_tree" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_smq_nonconformity_tree" />
        <field name="act_window_id" ref="action_smq_nonconformity" />
    </record>

    <record id="action_smq_nonconformity_view_form" model="ir.actions.act_window.view">
        <field name="sequence">30</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_smq_nonconformity_form" />
        <field name="act_window_id" ref="action_smq_nonconformity" />
    </record>

</odoo>
