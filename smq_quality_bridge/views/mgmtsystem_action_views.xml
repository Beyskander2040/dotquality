<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Masque le champ "System" (mgmtsystem.system), hors périmètre SMQ -->
    <record id="view_mgmtsystem_action_form_hide_system" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.hide.system</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <field name="system_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//page[@name='extra']" position="attributes">
                <attribute name="string">Informations complémentaires</attribute>
            </xpath>
        </field>
    </record>

    <!-- Relabellise le smart button "Nonconformities" ajouté par
         mgmtsystem_nonconformity -->
    <record id="view_mgmtsystem_action_form_nc_button_fr" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.nc.button.fr</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_nonconformity.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <field name="nonconformity_count" position="attributes">
                <attribute name="string">Non-conformités</attribute>
            </field>
        </field>
    </record>

    <!-- Complète l'onglet "Efficacité" ajouté par mgmtsystem_action_efficacy
         avec le résultat en 3 niveaux et la date de vérification. -->
    <record id="view_mgmtsystem_action_form_efficacy_fr" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.efficacy.fr</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action_efficacy.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="attributes">
                <attribute name="string">Vérification de l'efficacité</attribute>
            </xpath>
            <field name="efficacy_value" position="before">
                <field name="efficacy_result" />
                <field name="efficacy_date" />
            </field>
            <field name="efficacy_value" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <!-- Filtres de recherche en français -->
    <record id="view_mgmtsystem_action_filter_fr" model="ir.ui.view">
        <field name="name">mgmtsystem.action.filter.fr</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_filter" />
        <field name="arch" type="xml">
            <filter name="pending" position="attributes">
                <attribute name="string">En cours</attribute>
            </filter>
            <filter name="my_actions" position="attributes">
                <attribute name="string">Mes actions</attribute>
            </filter>
        </field>
    </record>

    <record id="action_smq_corrective_action" model="ir.actions.act_window">
        <field name="name">Actions correctives</field>
        <field name="res_model">mgmtsystem.action</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'default_type_action': 'correction', 'search_default_my_actions': 0}</field>
    </record>

    <!-- Smart button "Risques" (smq_risk) sur la fiche Action -->
    <record id="view_mgmtsystem_action_form_risk_button" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.risk.button</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_risks"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exclamation-circle"
                    invisible="risk_count == 0"
                >
                    <field name="risk_count" string="Risques" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

    <!-- Smart button "Réclamations" (smq_complaint) sur la fiche Action -->
    <record id="view_mgmtsystem_action_form_complaint_button" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.complaint.button</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_complaints"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-comments-o"
                    invisible="complaint_count == 0"
                >
                    <field name="complaint_count" string="Réclamations" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

    <!-- Smart button "Formations" (smq_training) sur la fiche Action -->
    <record id="view_mgmtsystem_action_form_training_button" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.training.button</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_trainings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-graduation-cap"
                    invisible="training_count == 0"
                >
                    <field name="training_count" string="Formations" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

    <!-- Smart button "Évaluations fournisseurs" (smq_supplier) sur la fiche Action -->
    <record id="view_mgmtsystem_action_form_supplier_evaluation_button" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.supplier.evaluation.button</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_supplier_evaluations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="supplier_evaluation_count == 0"
                >
                    <field name="supplier_evaluation_count" string="Fournisseurs" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
